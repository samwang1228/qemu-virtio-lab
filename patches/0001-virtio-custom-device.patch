--- /dev/null
+++ b/include/hw/virtio/virtio-custom.h
@@ -0,0 +1,40 @@
+/*
+ * Virtio Custom Device Support
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * (at your option) any later version.
+ */
+
+#ifndef QEMU_VIRTIO_CUSTOM_H
+#define QEMU_VIRTIO_CUSTOM_H
+
+#include "hw/virtio/virtio-pci.h"
+#include "hw/virtio/virtio.h"
+#include "qom/object.h"
+#include "standard-headers/linux/virtio_ids.h"
+
+#define TYPE_VIRTIO_CUSTOM "virtio-custom-device"
+OBJECT_DECLARE_SIMPLE_TYPE(VirtIOCustom, VIRTIO_CUSTOM)
+
+typedef struct VirtIOCustomPCI VirtIOCustomPCI;
+
+#define TYPE_VIRTIO_CUSTOM_PCI "virtio-custom-pci-base"
+DECLARE_INSTANCE_CHECKER(VirtIOCustomPCI, VIRTIO_CUSTOM_PCI,
+                         TYPE_VIRTIO_CUSTOM_PCI)
+
+#include "standard-headers/linux/virtio_custom.h"
+
+typedef struct virtio_custom_config VirtIOCustomConfig;
+
+struct VirtIOCustom {
+  VirtIODevice parent_obj;
+  VirtQueue *vq;
+  VirtIOCustomConfig config;
+};
+
+struct VirtIOCustomPCI {
+  VirtIOPCIProxy parent_obj;
+  VirtIOCustom vdev;
+};
+
+#endif
