diff --git a/hw/virtio/virtio-custom-pci.c b/hw/virtio/virtio-custom-pci.c
new file mode 100644
index 0000000..2fcd3cf
--- /dev/null
+++ b/hw/virtio/virtio-custom-pci.c
@@ -0,0 +1,75 @@
+/*
+ * Virtio custom PCI Bindings
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/virtio/virtio-pci.h"
+#include "hw/virtio/virtio-custom.h"
+#include "hw/qdev-properties.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+static Property virtio_custom_properties[] = {
+    DEFINE_PROP_BIT("ioeventfd", VirtIOPCIProxy, flags,
+                    VIRTIO_PCI_FLAG_USE_IOEVENTFD_BIT, true),
+    DEFINE_PROP_UINT32("vectors", VirtIOPCIProxy, nvectors,
+                       DEV_NVECTORS_UNSPECIFIED),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void virtio_custom_pci_realize(VirtIOPCIProxy *vpci_dev, Error **errp)
+{
+    VirtIOCustomPCI *vcustom = VIRTIO_CUSTOM_PCI(vpci_dev);
+    DeviceState *vdev = DEVICE(&vcustom->vdev);
+
+    virtio_pci_force_virtio_1(vpci_dev);
+    if (vpci_dev->nvectors == DEV_NVECTORS_UNSPECIFIED) {
+        vpci_dev->nvectors = 2;
+    }
+
+    qdev_realize(vdev, BUS(&vpci_dev->bus), errp);
+}
+
+static void virtio_custom_pci_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    VirtioPCIClass *k = VIRTIO_PCI_CLASS(klass);
+    PCIDeviceClass *pcidev_k = PCI_DEVICE_CLASS(klass);
+
+    k->realize = virtio_custom_pci_realize;
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+
+    pcidev_k->vendor_id = PCI_VENDOR_ID_REDHAT_QUMRANET;
+    pcidev_k->device_id = PCI_DEVICE_ID_VIRTIO_10_BASE + VIRTIO_ID_CUSTOM;
+    pcidev_k->revision = VIRTIO_PCI_ABI_VERSION;
+    pcidev_k->class_id = PCI_CLASS_OTHERS;
+    device_class_set_props(dc, virtio_custom_properties);
+}
+
+static void virtio_custom_pci_initfn(Object *obj)
+{
+    VirtIOCustomPCI *dev = VIRTIO_CUSTOM_PCI(obj);
+
+    virtio_instance_init_common(obj, &dev->vdev, sizeof(dev->vdev),
+                                TYPE_VIRTIO_CUSTOM);
+}
+
+static const VirtioPCIDeviceTypeInfo virtio_custom_pci_info = {
+    .base_name             = TYPE_VIRTIO_CUSTOM_PCI,
+    .generic_name          = "virtio-custom-pci",
+    .non_transitional_name = "virtio-custom-pci-non-transitional",
+    .instance_size         = sizeof(VirtIOCustomPCI),
+    .instance_init         = virtio_custom_pci_initfn,
+    .class_init            = virtio_custom_pci_class_init,
+};
+
+static void virtio_custom_pci_register(void)
+{
+    virtio_pci_types_register(&virtio_custom_pci_info);
+}
+
+type_init(virtio_custom_pci_register)
diff --git a/hw/virtio/virtio-custom.c b/hw/virtio/virtio-custom.c
new file mode 100644
index 0000000..f1be779
--- /dev/null
+++ b/hw/virtio/virtio-custom.c
@@ -0,0 +1,192 @@
+/*
+ * Virtio Custom Device Implementation
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/iov.h"
+#include "qemu/module.h"
+#include "sysemu/dma.h"
+#include "hw/virtio/virtio.h"
+#include "hw/virtio/virtio-custom.h"
+#include "migration/vmstate.h"
+
+#define VIRTIO_CUSTOM_MAX_DMA_LEN (16 * 1024 * 1024)
+
+static void virtio_custom_get_config(VirtIODevice *vdev, uint8_t *config)
+{
+    VirtIOCustom *vcustom = VIRTIO_CUSTOM(vdev);
+    memcpy(config, &vcustom->config, sizeof(VirtIOCustomConfig));
+}
+
+static void virtio_custom_set_config(VirtIODevice *vdev, const uint8_t *config)
+{
+    VirtIOCustom *vcustom = VIRTIO_CUSTOM(vdev);
+    memcpy(&vcustom->config, config, sizeof(VirtIOCustomConfig));
+}
+
+static void virtio_custom_handle_output(VirtIODevice *vdev, VirtQueue *vq)
+{
+    VirtIOCustom *vcustom = VIRTIO_CUSTOM(vdev);
+    VirtQueueElement *elem;
+
+    while ((elem = virtqueue_pop(vq, sizeof(VirtQueueElement))) != NULL) {
+        size_t out_len = iov_size(elem->out_sg, elem->out_num);
+
+        if (out_len >= sizeof(struct virtio_custom_dma_cmd)) {
+            struct virtio_custom_dma_cmd cmd;
+            struct virtio_custom_dma_resp resp = {
+                .status = VIRTIO_CUSTOM_STATUS_OK,
+                .transferred = 0,
+            };
+
+            iov_to_buf(elem->out_sg, elem->out_num, 0, &cmd, sizeof(cmd));
+
+            if (cmd.len == 0 || cmd.len > VIRTIO_CUSTOM_MAX_DMA_LEN) {
+                resp.status = VIRTIO_CUSTOM_STATUS_EINVAL;
+            } else {
+                uint8_t *buf = g_try_malloc(cmd.len);
+                if (!buf) {
+                    resp.status = VIRTIO_CUSTOM_STATUS_ENOMEM;
+                } else {
+                    MemTxResult res = MEMTX_OK;
+
+                    switch (cmd.opcode) {
+                    case VIRTIO_CUSTOM_DMA_COPY:
+                        res = dma_memory_read(vdev->dma_as, cmd.src_addr,
+                                              buf, cmd.len,
+                                              MEMTXATTRS_UNSPECIFIED);
+                        if (res == MEMTX_OK) {
+                            res = dma_memory_write(vdev->dma_as, cmd.dst_addr,
+                                                   buf, cmd.len,
+                                                   MEMTXATTRS_UNSPECIFIED);
+                        }
+                        break;
+                    case VIRTIO_CUSTOM_DMA_INVERT:
+                        res = dma_memory_read(vdev->dma_as, cmd.src_addr,
+                                              buf, cmd.len,
+                                              MEMTXATTRS_UNSPECIFIED);
+                        if (res == MEMTX_OK) {
+                            for (uint32_t i = 0; i < cmd.len; i++) {
+                                buf[i] = ~buf[i];
+                            }
+                            res = dma_memory_write(vdev->dma_as, cmd.dst_addr,
+                                                   buf, cmd.len,
+                                                   MEMTXATTRS_UNSPECIFIED);
+                        }
+                        break;
+                    case VIRTIO_CUSTOM_DMA_FILL:
+                        memset(buf, (uint8_t)cmd.pattern, cmd.len);
+                        res = dma_memory_write(vdev->dma_as, cmd.dst_addr,
+                                               buf, cmd.len,
+                                               MEMTXATTRS_UNSPECIFIED);
+                        break;
+                    default:
+                        resp.status = VIRTIO_CUSTOM_STATUS_EINVAL;
+                        break;
+                    }
+                    g_free(buf);
+
+                    if (resp.status == VIRTIO_CUSTOM_STATUS_OK) {
+                        if (res != MEMTX_OK) {
+                            resp.status = VIRTIO_CUSTOM_STATUS_EIO;
+                        } else {
+                            resp.transferred = cmd.len;
+                            vcustom->config.dma_transfers++;
+                            vcustom->config.dma_bytes += resp.transferred;
+                        }
+                    }
+                }
+            }
+
+            if (elem->in_num > 0) {
+                iov_from_buf(elem->in_sg, elem->in_num, 0, &resp,
+                             MIN(sizeof(resp), iov_size(elem->in_sg, elem->in_num)));
+            }
+            virtqueue_push(vq, elem, sizeof(resp));
+        } else {
+            /* Legacy counter test */
+            vcustom->config.write_count++;
+            if (elem->in_num > 0) {
+                iov_from_buf(elem->in_sg, elem->in_num, 0,
+                             &vcustom->config.write_count,
+                             MIN(sizeof(vcustom->config.write_count),
+                                 iov_size(elem->in_sg, elem->in_num)));
+            }
+            virtqueue_push(vq, elem, 0);
+        }
+
+        g_free(elem);
+    }
+    virtio_notify(vdev, vq);
+}
+
+static void virtio_custom_device_realize(DeviceState *dev, Error **errp)
+{
+    VirtIODevice *vdev = VIRTIO_DEVICE(dev);
+    VirtIOCustom *vcustom = VIRTIO_CUSTOM(dev);
+
+    virtio_init(vdev, VIRTIO_ID_CUSTOM, sizeof(VirtIOCustomConfig));
+    vcustom->vq = virtio_add_queue(vdev, 128, virtio_custom_handle_output);
+    vcustom->config.write_count = 0;
+    vcustom->config.dma_transfers = 0;
+    vcustom->config.dma_bytes = 0;
+}
+
+static void virtio_custom_device_unrealize(DeviceState *dev)
+{
+    VirtIODevice *vdev = VIRTIO_DEVICE(dev);
+
+    virtio_del_queue(vdev, 0);
+    virtio_cleanup(vdev);
+}
+
+static const VMStateDescription vmstate_virtio_custom = {
+    .name = "virtio-custom",
+    .minimum_version_id = 1,
+    .version_id = 2,
+    .fields = (const VMStateField[]) {
+        VMSTATE_VIRTIO_DEVICE,
+        VMSTATE_UINT64(config.write_count, VirtIOCustom),
+        VMSTATE_UINT64(config.dma_transfers, VirtIOCustom),
+        VMSTATE_UINT64(config.dma_bytes, VirtIOCustom),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static uint64_t virtio_custom_get_features(VirtIODevice *vdev, uint64_t f,
+                                           Error **errp)
+{
+    return f;
+}
+
+static void virtio_custom_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    VirtioDeviceClass *vdc = VIRTIO_DEVICE_CLASS(klass);
+
+    dc->vmsd = &vmstate_virtio_custom;
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+    vdc->realize = virtio_custom_device_realize;
+    vdc->unrealize = virtio_custom_device_unrealize;
+    vdc->get_config = virtio_custom_get_config;
+    vdc->set_config = virtio_custom_set_config;
+    vdc->get_features = virtio_custom_get_features;
+}
+
+static const TypeInfo virtio_custom_info = {
+    .name = TYPE_VIRTIO_CUSTOM,
+    .parent = TYPE_VIRTIO_DEVICE,
+    .instance_size = sizeof(VirtIOCustom),
+    .class_init = virtio_custom_class_init,
+};
+
+static void virtio_custom_register_types(void)
+{
+    type_register_static(&virtio_custom_info);
+}
+
+type_init(virtio_custom_register_types)
